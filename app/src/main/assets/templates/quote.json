      "bold": true,
      "alignment": "START",
      "maxLines": 2,
      "autoFit": true,
      "font": "HEADING"
    },
    {
      "type": "text",
      "id": "source",
      "x": 12,
      "y": 88,
      "width": 76,
      "height": 5,
      "role": "BODY",
      "text": "{source}",
      "sizeSp": 15,
      "color": "$muted",
      "bold": false,
      "alignment": "START",
      "maxLines": 2,
      "autoFit": true,
      "font": "HEADING"
