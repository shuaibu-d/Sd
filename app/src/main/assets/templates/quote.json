      "colors": {
        "navy": "#102B35",
        "teal": "#159B98",
        "gold": "#D5B66D",
        "paper": "#F7F9F8",
        "ink": "#18343B",
        "muted": "#60747A",
        "white": "#FFFFFF",
        "surface": "#EAF0EF"
      }
    },
    {
      "id": "dark",
      "name": "Dark",
      "colors": {
        "navy": "#0B2028",
        "teal": "#35C4B8",
        "gold": "#D5B66D",
        "paper": "#0B2028",
        "ink": "#F4F7F6",
