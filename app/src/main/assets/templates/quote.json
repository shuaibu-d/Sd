      "id": "mark",
      "x": 8,
      "y": 10,
      "width": 14,
      "height": 17,
      "role": "HEADING",
      "text": "“",
      "sizeSp": 88,
      "color": "$white",
      "bold": true,
      "alignment": "CENTER",
      "maxLines": 2,
      "autoFit": true,
      "font": "HEADING"
    },
    {
      "type": "text",
      "id": "quote",
      "x": 12,
      "y": 30,
      "width": 76,
      "height": 38,
      "role": "HEADING",
